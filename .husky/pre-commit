files=$(git diff --cached --name-only --diff-filter=ACMRT | grep -E '\.(cjs|js|json|md|mjs|ts|tsx|yaml|yml)$' || true)

if [ -z "$files" ]; then
  exit 0
fi

# Block committing a dev-edited plugin manifest (must stay in published npx form).
if echo "$files" | grep -qE '^plugin/(\.claude-plugin|\.codex-plugin)/'; then
  node scripts/check-plugin-manifest.mjs || exit 1
fi

echo "$files" | xargs npx prettier --check
