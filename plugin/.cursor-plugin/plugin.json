{
  "name": "cognigy",
  "displayName": "Cognigy",
  "version": "1.12.0",
  "description": "NiCE Cognigy Plugin — create, test, and manage AI Agents on the NiCE Cognigy platform",
  "author": {
    "name": "Cognigy"
  },
  "publisher": "Cognigy",
  "homepage": "https://www.cognigy.com",
  "repository": "https://github.com/Cognigy/cognigy-plugin",
  "license": "MIT",
  "keywords": ["cognigy", "ai-agents", "conversational-ai", "mcp", "llm"],
  "category": "Productivity",
  "logo": "./assets/logo.png",
  "skills": "./skills/",
  "agents": "./agents/",
  "variables": {
    "type": "object",
    "properties": {
      "COGNIGY_API_BASE_URL": {
        "type": "string",
        "title": "Cognigy API base URL",
        "description": "Your Cognigy instance API URL. Use https://api-trial.cognigy.ai if you are on the trial.",
        "default": "https://api-trial.cognigy.ai"
      },
      "COGNIGY_API_KEY": {
        "type": "string",
        "title": "Cognigy API key",
        "description": "Find it in Cognigy.AI → User Menu → My Profile → API Keys."
      }
    },
    "required": ["COGNIGY_API_BASE_URL", "COGNIGY_API_KEY"]
  },
  "mcpServers": {
    "platform": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "cognigy-engine@npm:@cognigy/plugin-engine@1.12.0",
        "cognigy-mcp"
      ],
      "env": {
        "COGNIGY_API_BASE_URL": "${COGNIGY_API_BASE_URL}",
        "COGNIGY_API_KEY": "${COGNIGY_API_KEY}"
      }
    },
    "docs": {
      "url": "https://docs.cognigy.com/mcp"
    }
  }
}
