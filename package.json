{
  "name": "@cognigy/plugin-engine",
  "version": "1.22.5",
  "description": "MCP server engine for the NiCE Cognigy Plugin (Claude Code, Codex, and more)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "cognigy-setup": "dist/setup.js",
    "cognigy-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cognigy/cognigy-plugin"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && npx tsc && node scripts/copy-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "plugin:dev": "node scripts/dev-plugin.mjs on",
    "plugin:dev:off": "node scripts/dev-plugin.mjs off",
    "check:manifest": "node scripts/check-plugin-manifest.mjs",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prettier:check": "prettier --check",
    "prettier:write": "prettier --write",
    "lint": "eslint src",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "evals": "claude plugin eval plugin --ablation none --model claude-sonnet-5-5 --judge-model claude-haiku-5-5 --no-publish",
    "evals:tools": "tsx scripts/gen-eval-tools.ts",
    "evals:compare": "node scripts/eval-compare.mjs"
  },
  "keywords": [
    "mcp",
    "cognigy",
    "ai",
    "model-context-protocol",
    "mcp-server",
    "conversational-ai",
    "claude-code-plugin"
  ],
  "author": "Cognigy",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "axios": "1.21.0",
    "form-data": "4.0.6",
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "proxy-from-env": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.43",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jest": "30.5.2",
    "mermaid": "^12.2.0",
    "prettier": "3.9.10",
    "semantic-release": "^25.0.9",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
